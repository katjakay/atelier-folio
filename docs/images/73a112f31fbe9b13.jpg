      _BISConfig.product = {"id":14880364069251,"title":"no 2329 \/ Soft Cayetano","handle":"soft-cayetano-leather-bag-darkborwn","description":"\u003cp\u003eReissue of our classic Cayetano bag in soft leather.\u003c\/p\u003e\n\u003cp\u003e\u003cmeta charset=\"utf-8\"\u003e\u003cmeta charset=\"utf-8\"\u003eRectangular bag made from soft leather, featuring two strap lengths to wear short as a shoulder bag or long across your chest. Embossed logo and inner leather pocket. This new version includes an internal leather strap with a key clasp, and it is unlined to achieve a soft and unstructured shape.\u003cbr\u003e\u003c\/p\u003e\n\u003cp\u003eThe leather used for this style has a worn look and its appearance will change with use. Please note that marks and scratches are an intended attribute of this leather, but you can smooth out these marks using a dry cotton cloth. Due to the very natural treatment of the leather, with minimal coating and processing, the grain remains in its natural state, resulting in variations between pieces. Some areas may appear more pronounced and textured, while others may look smoother.\u003c\/p\u003e\n\u003cp\u003eColor brown.\u003c\/p\u003e\n\u003cp\u003eMade in Spain.\u003c\/p\u003e\n\u003cp\u003eRef. TR0006\u003c\/p\u003e","published_at":"2024-12-12T13:10:07+01:00","created_at":"2024-12-12T10:37:08+01:00","vendor":"Woman","type":"Leather bag","tags":["aw24","bags","bloque_2","cayetano","soft"],"price":26500,"price_min":26500,"price_max":26500,"available":true,"price_varies":false,"compare_at_price":null,"compare_at_price_min":0,"compare_at_price_max":0,"compare_at_price_varies":false,"variants":[{"id":54905300320643,"title":"ONE SIZE","option1":"ONE SIZE","option2":null,"option3":null,"sku":"TR0006326UN","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"name":"no 2329 \/ Soft Cayetano - ONE SIZE","public_title":"ONE SIZE","options":["ONE SIZE"],"price":26500,"weight":380,"compare_at_price":null,"inventory_ma