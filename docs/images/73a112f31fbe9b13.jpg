          ImageUrl: item.ImageURL,
          Url: item.URL,
          Metadata: {
            Brand: item.Brand,
            Price: item.Price,
            Value: item.Value,
            CompareAtPrice: item.CompareAtPrice
          },
          metafields:{
            reviews: MetafieldReviews,
            yotpo:{
              rating: MetafieldYotpoRating,
              count: MetafieldYotpoCount,
            },
            loox:{
              rating: MetafieldLooxRating,
              count: MetafieldLooxCount,
            },
            okendo: {
