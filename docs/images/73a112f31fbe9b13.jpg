      {"@context":"http:\/\/schema.org\/","@id":"\/products\/soft-cayetano-leather-bag-darkborwn#product","@type":"ProductGroup","brand":{"@type":"Brand","name":"Woman"},"category":"Shoulder Bags","description":"Reissue of our classic Cayetano bag in soft leather.\nRectangular bag made from soft leather, featuring two strap lengths to wear short as a shoulder bag or long across your chest. Embossed logo and inner leather pocket. This new version includes an internal leather strap with a key clasp, and it is unlined to achieve a soft and unstructured shape.\nThe leather used for this style has a worn look and its appearance will change with use. Please note that marks and scratches are an intended attribute of this leather, but you can smooth out these marks using a dry cotton cloth. Due to the very natural treatment of the leather, with minimal coating and processing, the grain remains in its natural state, resulting in variations between pieces. Some areas may appear more pronounced and textured, while others may look smoother.\nColor brown.\nMade in Spain.\nRef. TR0006","hasVariant":[{"@id":"\/products\/soft-cayetano-leather-bag-darkborwn?variant=54905300320643#variant","@type":"Product","gtin":"8445408161298","image":"https:\/\/palomawool.com\/cdn\/shop\/files\/AW24_PWMAN_DIC0456_5bb8bbe1-dcfd-4624-8817-e1c91a4aac8a.jpg?v=1742388593\u0026width=1920","name":"no 2329 \/ Soft Cayetano - ONE SIZE","offers":{"@id":"\/products\/soft-cayetano-leather-bag-darkborwn?variant=54905300320643#offer","@type":"Offer","availability":"http:\/\/schema.org\/InStock","price":"265.00","priceCurrency":"EUR","url":"https:\/\/palomawool.com\/products\/soft-cayetano-leather-bag-darkborwn?variant=54905300320643"},"sku":"TR0006326UN"}],"name":"no 2329 \/ Soft Cayetano","productGroupID":"14880364069251","url":"https:\/\/palomawool.com\/products\/soft-cayetano-leather-bag-darkborwn"}
